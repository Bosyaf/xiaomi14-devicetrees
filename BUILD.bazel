load("//build/kernel/kleaf:kernel.bzl", "kernel_dtstree")

kernel_dtstree(
    name = "msm_dt",
    srcs = glob(
        [
            "Makefile",
            "qcom/Makefile",
            "qcom/**/Makefile",
            "qcom/**/Kbuild",
            "qcom/**/*.mk",
            "qcom/**/*.dtsi",
            "qcom/**/*.dts",
            "bindings/**/*",
            "qcom/**/bindings/**/*",
        ],
        exclude = [
            "**/.*",
            "**/.*/**",
            "**/*.bazel",
            "**/*.bzl",
        ],
    ) + [
           "//vendor/qcom/opensource/audio-kernel:audio_common_headers",
           "//vendor/qcom/opensource/camera-kernel:camera_src_headers",
           "//vendor/qcom/opensource/synx-kernel:synx_headers",
    ],
    visibility = ["//visibility:public"],
)
